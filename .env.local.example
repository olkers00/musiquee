# Spotify Web API app credentials (Authorization Code + PKCE — no client
# secret needed, safe for a fully static/client-side app).
# Create an app at https://developer.spotify.com/dashboard, then add this
# exact redirect URI in the app's settings.
# Leave both empty to run Musiquee fully in Demo Mode (no Spotify account required).
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
